{
  "name": "@myopenclaw/cli",
  "version": "1.1.0",
  "private": true,
  "description": "MyOpenClaw CLI 命令行客户端 - 本地优先的 AI Agent 命令行交互工具",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "myopenclaw": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.0.0",
    "cosmiconfig": "^9.0.0",
    "inquirer": "^9.2.0",
    "ora": "^8.0.0",
    "ws": "^8.18.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
