{
  "name": "@myopenclaw/tui",
  "version": "1.0.0",
  "private": true,
  "description": "MyOpenClaw 终端 TUI 客户端",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:watch": "tsx src/main.ts",
    "dev:clean": "kill-port 18780 2>/dev/null; tsx src/main.ts",
    "start:watch": "nodemon --config nodemon.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(lint not configured)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "ink": "^4.4.0",
    "react": "^18.3.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^2.1.9",
    "happy-dom": "^15.11.7",
    "kill-port": "^2.0.1",
    "nodemon": "^3.0.3",
    "react-dom": "^18.3.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
