# ===========================================
# MyOpenClaw 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ===========================================

# --- 服务端口 ---
GATEWAY_WS_PORT=18780
GATEWAY_HTTP_PORT=18790

# --- LLM 配置 ---
# 至少配置一个 LLM Provider 的 API Key
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# LLM 默认模型
LLM_DEFAULT_MODEL=gpt-4o
LLM_MAX_TOKENS=4096

# --- 日志配置 ---
LOG_LEVEL=info
# 可选: trace | debug | info | warn | error | fatal
LOG_SCOPE=
# 可选: gateway | agent | channels | tools | memory（留空显示全部）

# --- Gateway 调试（开发环境） ---
GATEWAY_LOG_LEVEL=debug
LOG_PAYLOAD=false

# --- Agent 调试（开发环境） ---
AGENT_LOG_REACT=false
AGENT_LOG_PROMPT=false
AGENT_LOG_RESPONSE=false
AGENT_MAX_REACT_STEPS=10

# --- 安全配置 ---
AUTH_TOKEN=your-auth-token-here
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- 记忆存储路径 ---
MEMORY_DIR=./data/memory
SESSION_DIR=./data/sessions
VECTOR_DB_DIR=./data/vectors

# --- 向量嵌入（可选） ---
# 不配置则降级为关键词检索
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-your-embedding-api-key

# --- Docker（可选） ---
# 用于工具执行沙箱隔离
DOCKER_HOST=
