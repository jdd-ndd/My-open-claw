# MyOpenClaw pnpm 配置
#
# pnpm 8+ 默认拒绝运行依赖的 install/postinstall build scripts,
# 这会阻断 esbuild / cpu-features / protobufjs / ssh2 的 native binary 部署,
# 进而导致 vite build 报 ENOENT / 单元测试启动失败。
#
# 显式跳过这些 scripts 是安全的: 我们不依赖这些包的 postinstall 副作用
# (它们的 native binary 已通过 prebuilt 二进制分发, 不需要编译)。
ignore-scripts=true
# pnpm 11+ 在 ignore-scripts=true 时会抛 ERR_PNPM_IGNORED_BUILDS 阻塞 install.
# v1.1.9: 这是 pnpm 11 唯一已知的 workaround — 必须明确 allow build 脚本.
# 我们 allow 一组 trusted native deps (esbuild/ssh2/protobufjs/cpu-features),
# 这些走 prebuilt binary, install 不会触发本地编译.
# (保留 ignore-scripts=true 是为了不跑其他非白名单包的 postinstall.)
onlyBuiltDependencies=["esbuild","cpu-features","protobufjs","ssh2"]
# pnpm 11 strict mode 关掉 (避免其他次要警告升级成 error)
package-manager-strict=false
