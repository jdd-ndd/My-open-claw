{
  "name": "myopenclaw",
  "version": "1.0.0",
  "private": true,
  "description": "MyOpenClaw - 本地优先、自托管的开源 AI Agent 框架",
  "license": "MIT",
  "author": "MyOpenClaw Core Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/myopenclaw/myopenclaw"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "workspaces": [
    "server",
    "clients/web",
    "clients/cli"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @myopenclaw/server",
    "build": "npm run build --workspace @myopenclaw/server && npm run build --workspace @myopenclaw/web",
    "typecheck": "npm run typecheck --workspace @myopenclaw/server",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "test": "npm run test --workspace @myopenclaw/server",
    "clean": "rimraf dist coverage .turbo",
    "env:check": "node scripts/env-check.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0"
  }
}
